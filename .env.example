# ── FastAPI backend ───────────────────────────────────────────
# Ключ подписи JWT. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@db:5432/archivedb
# Публичный адрес бэкенда (для ссылок на скачивание)
PUBLIC_API_URL=http://localhost:8000
# Разрешённые источники CORS (через запятую)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Next.js frontend (встраивается в сборку) ──────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
